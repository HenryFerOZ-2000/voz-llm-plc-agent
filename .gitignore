# =============================================================================
# voz_llm_plc_agent - que viaja por Git y que es local por PC (docs/multi_pc_setup.md)
# =============================================================================

# --- Entorno Python / caches -------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/

# --- Diagnosticos y carpetas locales de herramientas -------------------------
/CrashDumps/
/audit.json
/.ncintegration/
/.shared6/

# Paquetes de transferencia a Overleaf: solo locales.
/output/**/*.zip

# --- Secretos (versionar solo .env.example) ----------------------------------
.env
*.env
!.env.example

# --- Configuracion local por PC (versionar solo los *.example.json) ----------
config/tia_openness_config.json
config/tia_projects.json
config/normal_voice.json
config/voice_protocol_dev.json
config/host_local.json

# --- Mapas PLC ----------------------------------------------------------------
# Versionados: el BASE del banco y los mapas experimentales/simulacion/PID.
# Locales: <id>_working.json (Modo Normal), _active_map.json y respaldos de migracion.
data/plc_maps/*
!data/plc_maps/mapa_simulacion_completo.json
!data/plc_maps/mapa_banco_fisico_base.json
!data/plc_maps/mapa_pid_simulacion.json
!data/plc_maps/mapa_pid_banco_fisico.json
!data/plc_maps/mapa_experimental_simulacion.json
!data/plc_maps/profiles.json
!data/plc_maps/experiment_variants.json
*_working.json
*.pre_working.bak

# --- Proyectos y archivos TIA (red de seguridad global) ----------------------
tia_projects/
tia_master/
tiaw/
*.ap18
*.zap18
*.zap1[0-9]

# --- Artefactos generados por la aplicacion ----------------------------------
# Toda la salida de generacion es local; solo se versiona la estructura (.gitkeep).
generated_code/**
!generated_code/**/
!generated_code/**/.gitkeep

tia_openness_bridge/bin/*
!tia_openness_bridge/bin/.gitkeep
tia_openness_bridge/sync_map_request.json
tia_openness_bridge/sync_map_result.json

plcsim_runtime_bridge/bin/
plcsim_runtime_bridge/runtime_request.json
plcsim_runtime_bridge/runtime_result.json
plcsim_runtime_bridge/plcsim_runtime_report.json

# --- Resultados experimentales y registros de ejecucion (locales) ------------
experiments/
results/
runtime/
experimental_results/trials.csv
experimental_results/trials.jsonl
voice_evidence/
tmp_audio/
audio/

# --- Legacy local sin uso (entradas de menu del commit inicial) --------------
menu_input_clear.txt
menu_input_archive.txt

# --- Audio FORMAL v1.1 (nunca en Git) ------------------------------------------
# Corpus pareado clean/noisy (results/formal_audio, results/development_audio: ya bajo results/) y el ruido
# maestro industrial (su SHA-256 aprobado SI se versiona en config/formal_audio_config.json).
formal_assets/
*.wav
