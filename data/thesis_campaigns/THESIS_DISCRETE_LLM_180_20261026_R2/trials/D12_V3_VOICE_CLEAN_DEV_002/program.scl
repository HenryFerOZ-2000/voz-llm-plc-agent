FUNCTION_BLOCK "PLC_PRG"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   I_Contactor_A_Request : Bool := FALSE;
   I_Contactor_B_Request : Bool := FALSE;
   I_Emergency : Bool := FALSE;
END_VAR
VAR_OUTPUT
   Q_Contactor_A : Bool := FALSE;
   Q_Contactor_B : Bool := FALSE;
END_VAR
BEGIN
(* Enclavamiento mutuo: cada contactor sigue su propia orden y nunca se activan los dos a la vez *)
(* (el contactor que ya esta activo conserva la prioridad mientras su orden siga presente). *)
IF #I_Emergency THEN
    #Q_Contactor_A := FALSE;
    #Q_Contactor_B := FALSE;
ELSE
    #Q_Contactor_A := #I_Contactor_A_Request AND NOT #Q_Contactor_B;
    #Q_Contactor_B := #I_Contactor_B_Request AND NOT #Q_Contactor_A;
END_IF;
(* Invariante de seguridad: #Q_Contactor_A, #Q_Contactor_B nunca activas a la vez *)
IF (#Q_Contactor_A AND #Q_Contactor_B) THEN
    #Q_Contactor_A := FALSE;
    #Q_Contactor_B := FALSE;
END_IF;
END_FUNCTION_BLOCK

