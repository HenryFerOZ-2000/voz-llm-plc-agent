FUNCTION_BLOCK "PLC_PRG"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   I_Start : Bool := FALSE;
   I_Emergency : Bool := FALSE;
   I_Safety_Condition : Bool := FALSE;
END_VAR
VAR_OUTPUT
   Q_Alarm : Bool := FALSE;
   Q_System_Enable : Bool := FALSE;
END_VAR
VAR
   M_FaultLatch : Bool;
END_VAR
BEGIN
(* Arranque seguro con alarma si no existe la condicion habilitante *)
IF #I_Emergency THEN
    #Q_System_Enable := FALSE;
    #M_FaultLatch := TRUE;
ELSIF #I_Start AND NOT #I_Safety_Condition THEN
    #Q_System_Enable := FALSE;
    #M_FaultLatch := TRUE;
ELSIF #I_Start AND #I_Safety_Condition AND NOT #M_FaultLatch THEN
    #Q_System_Enable := TRUE;
END_IF;

IF FALSE AND NOT #I_Emergency THEN
    #M_FaultLatch := FALSE;
END_IF;

#Q_Alarm := #M_FaultLatch;
END_FUNCTION_BLOCK

