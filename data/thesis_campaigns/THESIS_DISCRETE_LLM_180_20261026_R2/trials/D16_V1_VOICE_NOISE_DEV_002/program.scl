{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   I_Start : Bool := FALSE;
   I_Emergency : Bool := FALSE;
END_VAR
VAR_OUTPUT
   Q_Contactor_Principal : Bool := FALSE;
   Q_Aux_Output : Bool := FALSE;
END_VAR
VAR
   M_SequenceStep : Bool;
   T_MainToAuxDelay {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
END_VAR
BEGIN
(* Secuencia: con la orden de arranque se activa la salida principal y, tras la espera, la auxiliar *)
IF #I_Emergency THEN
    #M_SequenceStep := 0;
ELSIF #I_Start AND #M_SequenceStep = 0 THEN
    #M_SequenceStep := 1;
END_IF;

#T_MainToAuxDelay(IN := #M_SequenceStep = 1, PT := T#3s);
#Q_Contactor_Principal := #M_SequenceStep = 1 AND NOT #I_Emergency;
#Q_Aux_Output := #M_SequenceStep = 1 AND #T_MainToAuxDelay.Q AND NOT #I_Emergency;
(* Bloqueo: #I_Emergency fuerza a FALSE #Q_Contactor_Principal, #Q_Aux_Output de inmediato *)
IF #I_Emergency THEN
    #Q_Contactor_Principal := FALSE;
    #Q_Aux_Output := FALSE;
END_IF;
END_FUNCTION_BLOCK

