FUNCTION_BLOCK "PLC_PRG"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   I_Start : Bool := FALSE;
   I_Emergency : Bool := FALSE;
END_VAR
VAR_OUTPUT
   Q_Motor_Enable : Bool := FALSE;
END_VAR
VAR
   M_RunLatch : Bool;
   T_OperationLimit {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   M_Motor_EnableLatch : Bool;
END_VAR
BEGIN
(* Paro automatico del motor por tiempo de operacion *)
IF #I_Emergency OR FALSE THEN
    #M_RunLatch := FALSE;
ELSIF #I_Start THEN
    #M_RunLatch := TRUE;
END_IF;

#T_OperationLimit(IN := #M_RunLatch AND NOT #I_Emergency, PT := T#10s);

IF #T_OperationLimit.Q THEN
    #M_RunLatch := FALSE;
END_IF;

#Q_Motor_Enable := #M_RunLatch AND NOT #I_Emergency;
END_FUNCTION_BLOCK

