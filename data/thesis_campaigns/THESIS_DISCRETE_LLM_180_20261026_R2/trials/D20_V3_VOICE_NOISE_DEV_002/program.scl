FUNCTION_BLOCK "PLC_PRG"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   I_Start : Bool := FALSE;
   I_Reset : Bool := FALSE;
   I_Emergency : Bool := FALSE;
END_VAR
VAR_OUTPUT
   Q_Motor_Enable : Bool := FALSE;
   Q_Cycle_Complete : Bool := FALSE;
END_VAR
VAR
   M_Cycle_Step : Bool;
   T_Cycle {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
END_VAR
BEGIN
(* Ciclo automatico temporizado: 0 = inicial, 1 = en ejecucion, 2 = finalizado (hasta Reset) *)
IF #I_Emergency OR #I_Reset THEN
    #M_Cycle_Step := 0;
ELSIF #M_Cycle_Step = 0 AND #I_Start THEN
    #M_Cycle_Step := 1;
END_IF;

#T_Cycle(IN := #M_Cycle_Step = 1, PT := T#3s);
IF #M_Cycle_Step = 1 AND #T_Cycle.Q THEN
    #M_Cycle_Step := 2;
END_IF;

#Q_Motor_Enable := #M_Cycle_Step = 1 AND NOT #I_Emergency;
#Q_Cycle_Complete := #M_Cycle_Step = 2;
END_FUNCTION_BLOCK

