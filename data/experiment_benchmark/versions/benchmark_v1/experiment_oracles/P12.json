  "test_sequence": [
    {
      "id": "step_1",
      "description": "Automatico, setpoint 60 % y PID habilitado.",
      "wait_ms": 500,
      "expect": {
        "AUTO_MODE": true,
        "LEVEL_SP": {
          "approx": 60.0,
          "tolerance": 0.01
        },
        "PID_ENABLE": true,
        "HIGH_LEVEL_ALARM": false
      }
    },
    {
      "id": "step_2",
      "description": "Nivel 92 %: alarma alta (sin sobrellenado).",
      "set": {
        "LEVEL_PV": 92.0
      },
      "wait_ms": 500,
      "expect": {
        "HIGH_LEVEL_ALARM": true,
        "ALARM": true,
        "SAFE_STOP": false,
        "PID_ENABLE": true
      }
    },
    {
      "id": "step_3",
      "description": "Nivel 96 %: parada segura, PID y bomba deshabilitados.",
      "set": {
        "LEVEL_PV": 96.0
      },
      "wait_ms": 500,
      "expect": {
        "SAFE_STOP": true,
        "PID_ENABLE": false,
        "PUMP": false,
        "ALARM": true
      }
    },
    {
      "id": "step_4",
      "description": "RESET con la falla presente: no se borra.",
      "set": {
        "RESET": true
      },
      "wait_ms": 300,
      "expect": {
        "ALARM": true,
        "SAFE_STOP": true
      }
    },
    {
      "id": "step_5",
      "description": "Soltar RESET.",
      "set": {
        "RESET": false
      },
      "wait_ms": 300
    },
    {
      "id": "step_6",
      "description": "El nivel vuelve a 50 %: alarma alta desaparece.",
      "set": {
        "LEVEL_PV": 50.0
      },
      "wait_ms": 500,
      "expect": {
        "HIGH_LEVEL_ALARM": false
      }
    },
    {
      "id": "step_7",
      "description": "RESET sin falla: alarma y parada segura se borran.",
      "set": {
        "RESET": true
      },
      "wait_ms": 300,
      "expect": {
        "ALARM": false,
        "SAFE_STOP": false
      }
    },
    {
      "id": "step_8",
      "description": "Soltar RESET: recuperacion segura (PID habilitado de nuevo).",
      "set": {
        "RESET": false
      },
      "wait_ms": 500,
      "expect": {
        "PID_ENABLE": true
      }
    }
  ],
